index 0000000..ae72380
--- /dev/null
+++ b/lib/util/codefest_qr.dart
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+import 'dart:convert';
+
+import 'package:town_pass/util/codefest_station_points.g.dart';
+
+/// A locator can select a bundled point, never a URL or QR-supplied coordinates.
+String? codefestPointFromQr(String payload) {
+  if (utf8.encode(payload).length > 1024) return null;
+  Object? value;
+  try {
+    value = jsonDecode(payload);
+  } on FormatException {
+    return null;
+  }
+  const fields = {'type', 'v', 'site_id', 'graph_major', 'anchor_id'};
+  if (value is! Map<String, dynamic> ||
+      value.length != fields.length ||
+      !value.keys.every(fields.contains) ||
+      value['type'] != 'taipei_maze_anchor' ||
+      value['v'] is! int ||
+      value['v'] != 1 ||
+      value['site_id'] != 'taipei-main-map-preview' ||
+      value['graph_major'] is! int ||
+      value['graph_major'] != 1) {
+    return null;
+  }
+  final anchor = value['anchor_id'];
+  if (anchor is! String || !anchor.startsWith('station_')) return null;
+  final point = anchor.substring('station_'.length);
+  return codefestStationPointIds.contains(point) ? point : null;
+}
+
+Uri? codefestMapFromQr(String payload, Uri mapUrl) {
+  final point = codefestPointFromQr(payload);
+  if (point == null) return null;
+  return mapUrl.removeFragment().replace(path: '/station-map', queryParameters: {'point': point, 'v': '1'});
+}
