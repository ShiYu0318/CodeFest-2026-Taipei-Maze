+++ b/test/codefest_qr_test.dart
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+import 'dart:convert';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:town_pass/util/codefest_qr.dart';
+import 'package:town_pass/util/codefest_station_points.g.dart';
+
+Map<String, Object?> anchor(String id) => {
+  'type': 'taipei_maze_anchor',
+  'v': 1,
+  'site_id': 'taipei-main-map-preview',
+  'graph_major': 1,
+  'anchor_id': 'station_$id',
+};
+
+void main() {
+  test('all enabled station codes open the configured map with only point and version', () {
+    final base = Uri.parse('http://home.yoyo899843.com:8000/?untrusted=old#old');
+    for (final id in codefestStationPointIds) {
+      final payload = jsonEncode(anchor(id));
+      expect(codefestPointFromQr(payload), id);
+      final destination = codefestMapFromQr(payload, base)!;
+      expect(destination.origin, base.origin);
+      expect(destination.path, '/station-map');
+      expect(destination.queryParameters, {'point': id, 'v': '1'});
+      expect(destination.fragment, '');
+    }
+  });
+
+  test('unknown, foreign, incompatible, extra fields and arbitrary links never open', () {
+    final valid = anchor('b1-e4');
+    final bad = <Object?>[
+      null,
+      [],
+      {},
+      'https://example.com/station-map?point=b1-e4',
+      {...valid, 'anchor_id': 'station_missing'},
+      {...valid, 'anchor_id': 'b1-e4'},
+      {...valid, 'anchor_id': null},
+      {...valid, 'type': 'something_else'},
+      {...valid, 'site_id': 'foreign'},
+      {...valid, 'v': 2},
+      {...valid, 'v': '1'},
+      {...valid, 'v': 1.0},
+      {...valid, 'graph_major': 2},
+      {...valid, 'graph_major': true},
+      {...valid, 'url': 'https://example.com/'},
+      {...valid}..remove('graph_major'),
+    ];
+    for (final value in bad) {
+      expect(codefestMapFromQr(jsonEncode(value), Uri.parse('https://trusted.example')), isNull);
+    }
+    expect(codefestPointFromQr('not json'), isNull);
+    expect(codefestPointFromQr('${' ' * 1024}${jsonEncode(valid)}'), isNull);
+    expect(codefestPointFromQr('${'漢' * 350}${jsonEncode(valid)}'), isNull);
+    expect(codefestPointFromQr('  ${jsonEncode(valid)}  '), 'b1-e4');
+  });
+}
