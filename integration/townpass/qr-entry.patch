+// SPDX-License-Identifier: AGPL-3.0-or-later
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:get/get.dart';
+import 'package:town_pass/page/qr_code_scan/qr_code_scan_controller.dart';
+import 'package:town_pass/util/codefest_qr_scanner.dart';
+import 'package:town_pass/util/tp_route.dart';
+import 'package:town_pass/util/tp_web_view.dart';
+import 'package:town_pass/util/web_message_handler/tp_web_message_handler.dart';
+
+void main() {
+  final payload = jsonEncode({
+    'type': 'taipei_maze_anchor',
+    'v': 1,
+    'site_id': 'taipei-main-map-preview',
+    'graph_major': 1,
+    'anchor_id': 'station_b1-e4',
+  });
+  String? scanned;
+  WebViewArgument? opened;
+  Object? scanArguments;
+  int cameraOpens = 0;
+
+  Future<void> mount(WidgetTester tester) async {
+    opened = null;
+    scanArguments = null;
+    cameraOpens = 0;
+    await tester.pumpWidget(
+      GetMaterialApp(
+        home: const Scaffold(body: Text('TownPass home')),
+        getPages: [
+          GetPage(
+            name: TPRoute.qrCodeScan,
+            transition: Transition.noTransition,
+            page: () {
+              cameraOpens++;
+              scanArguments = Get.arguments;
+              return Scaffold(
+                body: TextButton(
+                  onPressed: () => Get.back(result: scanned),
+                  child: const Text('Return native scan'),
+                ),
+              );
+            },
+          ),
+          GetPage(
+            name: TPRoute.webView,
+            transition: Transition.noTransition,
+            page: () {
+              opened = Get.arguments as WebViewArgument;
+              return const Scaffold(body: Text('Codefest map'));
+            },
+          ),
+        ],
+      ),
+    );
+    await tester.pumpAndSettle();
+  }
+
+  tearDown(Get.reset);
+
+  testWidgets('homepage scan opens Codefest once and repeated taps do not open another camera', (tester) async {
+    scanned = payload;
+    await mount(tester);
+    final pending = CodefestQrScanner.open();
+    await tester.pumpAndSettle();
+    await CodefestQrScanner.open();
+    expect(cameraOpens, 1);
+    expect((scanArguments as QRCodeScanArguments).instruction, contains('北車不迷路'));
+    await tester.tap(find.text('Return native scan'));
+    await tester.pumpAndSettle();
+    expect(find.text('Codefest map'), findsOneWidget);
+    expect(opened?.url, 'http://home.yoyo899843.com:8000/station-map?point=b1-e4&v=1');
+    expect(opened?.forceTitle, '北車不迷路');
+    Get.back();
+    await tester.pumpAndSettle();
+    await pending;
+    expect(find.text('TownPass home'), findsOneWidget);
+  });
+
+  testWidgets('cancel returns home and releases the scanner for retry', (tester) async {
+    scanned = null;
+    await mount(tester);
+    for (var i = 0; i < 2; i++) {
+      final pending = CodefestQrScanner.open();
+      await tester.pumpAndSettle();
+      await tester.tap(find.text('Return native scan'));
+      await tester.pumpAndSettle();
+      await pending;
+      expect(opened, isNull);
+      expect(find.text('TownPass home'), findsOneWidget);
+    }
+    expect(cameraOpens, 2);
+  });
+
+  testWidgets('unsupported QR shows a recoverable error and never opens a URL', (tester) async {
+    scanned = 'https://untrusted.example/';
+    await mount(tester);
+    final pending = CodefestQrScanner.open();
+    await tester.pumpAndSettle();
+    await tester.tap(find.text('Return native scan'));
+    await tester.pumpAndSettle();
+    expect(opened, isNull);
+    expect(find.text('無法開啟定位碼'), findsOneWidget);
+    await tester.tap(find.text('確認'));
+    await tester.pumpAndSettle();
+    await pending;
+    expect(find.text('TownPass home'), findsOneWidget);
+  });
+
+  testWidgets('web bridge scans return raw QR without opening a second WebView', (tester) async {
+    scanned = payload;
+    await mount(tester);
+    Object? reply;
+    final pending = QRCodeScanMessageHandler().handle(
+      message: null,
+      sourceOrigin: null,
+      isMainFrame: true,
+      onReply: (message) {
+        reply = jsonDecode(message.data);
+      },
+    );
+    await tester.pumpAndSettle();
+    expect(scanArguments, isNull);
+    await tester.tap(find.text('Return native scan'));
+    await tester.pumpAndSettle();
+    await pending;
+    expect(reply, {'name': 'qr_code_scan', 'data': payload});
+    expect(opened, isNull);
+  });
+}
