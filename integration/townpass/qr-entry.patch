@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+import 'package:get/get.dart';
+import 'package:town_pass/page/qr_code_scan/qr_code_scan_controller.dart';
+import 'package:town_pass/util/codefest_qr.dart';
+import 'package:town_pass/util/tp_dialog.dart';
+import 'package:town_pass/util/tp_route.dart';
+
+abstract class CodefestQrScanner {
+  static bool _opening = false;
+  static const mapUrl = String.fromEnvironment(
+    'CODEFEST_MAP_URL',
+    defaultValue: 'http://home.yoyo899843.com:8000/station-map',
+  );
+
+  /// Only the homepage owns navigation. Web bridge scans still return raw text.
+  static Future<void> open() async {
+    if (_opening) return;
+    _opening = true;
+    try {
+      final Object? payload = await Get.toNamed(
+        TPRoute.qrCodeScan,
+        arguments: const QRCodeScanArguments(instruction: '請掃描北車不迷路定位 QR Code'),
+      );
+      if (payload == null) return;
+      final destination = payload is String ? codefestMapFromQr(payload, Uri.parse(mapUrl)) : null;
+      if (destination == null) {
+        await TPDialog.showError(title: '無法開啟定位碼', content: '請掃描北車不迷路的有效定位 QR Code。');
+        return;
+      }
+      await TPRoute.openUri(uri: destination.toString(), forceTitle: '北車不迷路');
+    } finally {
+      _opening = false;
+    }
+  }
+}
