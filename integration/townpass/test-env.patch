+// SPDX-License-Identifier: AGPL-3.0-or-later
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:mobile_scanner/mobile_scanner.dart';
+import 'package:town_pass/page/codefest_scan/codefest_scan_session.dart';
+
+class CodefestScanView extends StatefulWidget {
+  const CodefestScanView({super.key, required this.session});
+  final CodefestScanSession session;
+  @override
+  State<CodefestScanView> createState() => _CodefestScanViewState();
+}
+
+class _CodefestScanViewState extends State<CodefestScanView>
+    with WidgetsBindingObserver {
+  final _camera = MobileScannerController(
+    autoStart: false,
+    formats: [BarcodeFormat.qrCode],
+    detectionSpeed: DetectionSpeed.normal,
+  );
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    widget.session.addListener(_checkClose);
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      _checkClose();
+      if (mounted && !widget.session.closing) unawaited(_start());
+    });
+  }
+
+  Future<void> _start() async {
+    try {
+      await _camera.start();
+    } catch (_) {
+      /* MobileScanner errorBuilder displays camera failure. */
+    }
+  }
+
+  Future<void> _stop() async {
+    try {
+      await _camera.stop();
+    } catch (_) {}
+  }
+
+  void _checkClose() {
+    if (mounted &&
+        widget.session.closing &&
+        ModalRoute.of(context)?.isCurrent == true)
+      Navigator.of(context).pop();
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.resumed && !widget.session.closing)
+      unawaited(_start());
+    else if (state != AppLifecycleState.resumed)
+      unawaited(_stop());
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    widget.session.removeListener(_checkClose);
+    unawaited(_camera.dispose());
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      appBar: AppBar(
+        title: const Text('持續掃碼導航'),
+        leading: CloseButton(onPressed: () => Navigator.of(context).pop()),
+      ),
+      body: SafeArea(
+        child: Column(
+          children: [
+            Expanded(
+              flex: 3,
+              child: MobileScanner(
+                controller: _camera,
+                onDetect: (capture) {
+                  if (!mounted) return;
+                  for (final code in capture.barcodes) {
+                    final payload = code.rawValue;
+                    if (payload != null &&
+                        widget.session.acceptPayload(payload))
+                      break;
+                  }
+                },
+                errorBuilder: (context, error) => const Center(
+                  child: Padding(
+                    padding: EdgeInsets.all(24),
+                    child: Text('相機不可用或尚未授權。請確認權限；可返回網頁，保留目的地。'),
+                  ),
+                ),
+              ),
+            ),
+            Expanded(
+              flex: 2,
+              child: ValueListenableBuilder<Map<String, Object>>(
+                valueListenable: widget.session,
+                builder: (context, guide, child) => Column(
+                  children: [
+                    Expanded(
+                      child: SingleChildScrollView(
+                        child: Padding(
+                          padding: const EdgeInsets.all(20),
+                          child: Column(
+                            crossAxisAlignment: CrossAxisAlignment.start,
+                            children: [
+                              Text(
+                                '${guide['title']} · ${guide['floor']}',
+                                style: Theme.of(context).textTheme.titleMedium,
+                              ),
+                              const SizedBox(height: 12),
+                              Text(
+                                guide['instruction']! as String,
+                                style: const TextStyle(
+                                  fontSize: 22,
+                                  height: 1.5,
+                                ),
+                              ),
+                              const SizedBox(height: 8),
+                              const Text(
+                                '掃下一個定位碼即可更新位置。重複影格不會反覆重算；同碼需按下方重新讀取。',
+                              ),
+                            ],
+                          ),
+                        ),
+                      ),
+                    ),
+                    Padding(
+                      padding: const EdgeInsets.fromLTRB(16, 0, 16, 12),
+                      child: Wrap(
+                        spacing: 12,
+                        runSpacing: 8,
+                        children: [
+                          FilledButton(
+                            onPressed: guide['canAdvance'] == true
+                                ? () => widget.session.requestAdvance(
+                                    guide['guidanceToken']! as String,
+                                  )
+                                : null,
+                            child: Text(guide['nextLabel']! as String),
+                          ),
+                          OutlinedButton(
+                            onPressed: () {
+                              widget.session.allowSameCodeAgain();
+                            },
+                            child: const Text('重新讀取同一碼'),
+                          ),
+                          TextButton(
+                            onPressed: () => Navigator.of(context).pop(),
+                            child: const Text('關閉相機，回導航'),
+                          ),
+                        ],
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
diff --git a/lib/util/web_message_handler/codefest_ai_handler.dart b/lib/util/web_message_handler/codefest_ai_handler.dart
new file mode 100644
index 0000000..8b497fd
--- /dev/null
+++ b/lib/util/web_message_handler/codefest_ai_handler.dart
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+import 'package:flutter/services.dart';
+import 'package:get/get.dart';
+import 'package:town_pass/page/codefest_ai/gemma_setup_view.dart';
+import 'package:flutter_inappwebview/flutter_inappwebview.dart';
+import 'package:town_pass/util/web_message_handler/tp_web_message_handler.dart';
+
+class CodefestAIMessageHandler extends TPWebMessageHandler {
+  @override
+  String get name => 'codefest_ai';
+  bool _settingUp = false;
+  static const channel = MethodChannel('codefest/on_device_ai');
+  static const origins = {
+    'http://127.0.0.1:8082',
+    'http://localhost:8082',
+    'https://home.yoyo899843.com',
+  };
+  static const locales = {
+    'zh-TW',
+    'en-US',
+    'vi-VN',
+    'id-ID',
+    'th-TH',
+    'ko-KR',
+    'ja-JP',
+  };
+  static bool validId(Object? value) =>
+      value is String && RegExp(r'^[a-f0-9]{32}$').hasMatch(value);
+  @override
+  Future<void> handle({
+    required Object? message,
+    required WebUri? sourceOrigin,
+    required bool isMainFrame,
+    required Function(WebMessage replyWebMessage)? onReply,
+  }) async {
+    final origin = Uri.tryParse(sourceOrigin?.toString() ?? '');
+    if (!isMainFrame ||
+        origin == null ||
+        !origin.hasAuthority ||
+        !origins.contains(origin.origin) ||
+        message is! Map ||
+        !validId(message['requestId'])) {
+      return;
+    }
+    final id = message['requestId'];
+    final action = message['action'];
+    if (!{
+      'status',
+      'setup',
+      'generate',
+      'voice',
+      'stopVoice',
+      'cancel',
+      'unload',
+    }.contains(action)) {
+      return;
+    }
+    final prompt = message['prompt'];
+    if (action == 'generate' &&
+        (prompt is! String || prompt.trim().isEmpty || prompt.length > 6000)) {
+      return;
+    }
+    if (action == 'cancel' && !validId(message['targetRequestId'])) return;
+    if ({'status', 'voice'}.contains(action) &&
+        !locales.contains(message['locale'])) {
+      return;
+    }
+    Map result;
+    if (action == 'setup') {
+      if (_settingUp) {
+        onReply?.call(
+          replyWebMessage(
+            data: {'requestId': id, 'status': 'error', 'code': 'busy'},
+          ),
+        );
+        return;
+      }
+      _settingUp = true;
+      try {
+        await channel.invokeMethod('unload');
+        await Get.to(() => const GemmaSetupView());
+        onReply?.call(
+          replyWebMessage(data: {'requestId': id, 'status': 'success'}),
+        );
+      } finally {
+        _settingUp = false;
+      }
+      return;
+    }
+    try {
+      result =
+          await channel.invokeMapMethod<String, Object?>(action as String, {
+            'requestId': id,
+            if (action == 'generate') 'prompt': prompt,
+            if (action == 'cancel')
+              'targetRequestId': message['targetRequestId'],
+            if ({'status', 'voice'}.contains(action))
+              'locale': message['locale'],
+          }) ??
+          {'status': 'error', 'code': 'unavailable'};
+    } on PlatformException catch (e) {
+      result = {'status': 'error', 'code': e.code};
+    } on MissingPluginException {
+      result = {'status': 'error', 'code': 'unavailable'};
+    }
+    try {
+      onReply?.call(replyWebMessage(data: {...result, 'requestId': id}));
+    } catch (_) {
+      await channel.invokeMethod('cancel', {'targetRequestId': id});
+    }
+  }
+}
